# Copy this file to .env and fill in the values. Never commit .env.
# Each task that needs a new variable adds it below with a note on where the value comes from.

# PostgreSQL connection string. Production: from the Neon dashboard.
# Local development: run `pnpm --filter @pa/db local-db` and use the URL it prints.
DATABASE_URL=

# --- Back end (apps/api) ---
PORT=4000
# Web push keys. Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: address push services can contact, e.g. mailto:you@example.com
VAPID_SUBJECT=
# From the Resend dashboard
RESEND_API_KEY=
# Sender shown on reminder emails, e.g. Personal <reminders@yourdomain.com>
EMAIL_FROM=
# Public address of the web app, used for links in emails
WEB_ORIGIN=http://localhost:3000

# --- Local development only ---
# Account created by `node apps/api/scripts/create-dev-owner.js` against the local database.
DEV_OWNER_EMAIL=owner@localhost.test
DEV_OWNER_PASSWORD=

# --- Front end (apps/web) ---
# Where the back end runs. Defaults to http://localhost:4000 when unset.
# On Vercel set it to the Heroku app's address.
API_ORIGIN=
