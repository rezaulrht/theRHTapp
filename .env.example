# Copy this file to .env and fill in the values. Never commit .env.
# Each task that needs a new variable adds it below with a note on where the value comes from.

# PostgreSQL connection string. Production: from the Neon dashboard.
# Local development: run `pnpm --filter @pa/db local-db` and use the URL it prints.
DATABASE_URL=

# --- Back end (apps/api) ---
PORT=4000
# Web push keys. Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: address push services can contact, e.g. mailto:you@example.com
VAPID_SUBJECT=
# From the Resend dashboard
RESEND_API_KEY=
# Sender shown on reminder emails, e.g. The R.H.T App <reminders@yourdomain.com>
EMAIL_FROM=
# Public address of the web app, used for links in emails
WEB_ORIGIN=http://localhost:3000

# Cloudflare R2 for Vault files (see docs/setup/accounts.md). Leave empty in development
# to keep files in .localfiles/ instead. In production, uploads are refused until these are set.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Cache (optional) ---
# Upstash Redis keeps a shared copy of login checks and settings near the server, so they do not
# cost a trip to the far-away database. Create the database in the same region as the server.
# Without these the server keeps a copy in its own memory instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Assistant (optional) ---
# DeepSeek reads "Lunch 250 bkash" into the Add expense form. The key is normally added in
# Settings > Assistant; this variable is only a fallback. Leave both empty to keep it off.
DEEPSEEK_API_KEY=
# Encrypts a key saved from Settings. Leave empty to use the database address instead; set it
# (to any long random text) if that address may ever change, so a saved key keeps working.
SECRETS_KEY=

# --- Local development only ---
# Account created by `node apps/api/scripts/create-dev-owner.js` against the local database.
DEV_OWNER_EMAIL=owner@localhost.test
DEV_OWNER_PASSWORD=

# --- Front end (apps/web) ---
# Where the back end runs. Defaults to http://localhost:4000 when unset.
# On Vercel set it to the Heroku app's address.
API_ORIGIN=
