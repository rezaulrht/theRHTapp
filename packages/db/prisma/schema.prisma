generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// The single owner of the app. There is never more than one row.
model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  sessions       Session[]
}

model Session {
  id         String   @id @default(cuid())
  /// SHA-256 hex of the cookie value; the raw value is never stored.
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
}

/// One row per setting the owner has changed. Unchanged settings use the
/// defaults in @pa/shared.
model Setting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
}

model Reminder {
  id               String             @id @default(cuid())
  /// Which section owns it: system, money, habit or vault.
  ownerType        String
  ownerId          String?
  title            String
  body             String
  /// Path opened when the notification is tapped.
  url              String
  /// A Schedule from @pa/shared.
  schedule         Json
  channels         String[]
  ignoreQuietHours Boolean            @default(false)
  enabled          Boolean            @default(true)
  /// Next instant this reminder is due; null when it will not fire again.
  nextFireAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deliveries       ReminderDelivery[]

  @@index([enabled, nextFireAt])
  @@index([ownerType, ownerId])
}

/// One row per occurrence per channel. The unique key is what stops an
/// occurrence being sent twice.
model ReminderDelivery {
  id           String   @id @default(cuid())
  reminderId   String
  reminder     Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  occurrenceAt DateTime
  channel      String
  /// sent, failed, missed or suppressed
  status       String
  error        String?
  createdAt    DateTime @default(now())

  @@unique([reminderId, occurrenceAt, channel])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Money. Amounts are whole paisa. Balances are never stored: an account's
// balance is its opening balance plus the deltas of every entry touching it.
// ---------------------------------------------------------------------------

/// Where money sits: a bank account, bKash, cash.
model MoneyAccount {
  id             String    @id @default(cuid())
  name           String
  openingBalance Int
  openingDate    DateTime  @db.Date
  sortOrder      Int       @default(0)
  /// Set when hidden from pickers. History is kept.
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())

  entries     MoneyEntry[]    @relation("EntryAccount")
  entriesInto MoneyEntry[]    @relation("EntryToAccount")
  shortcuts   MoneyShortcut[]
}

model MoneyCategory {
  id         String    @id @default(cuid())
  name       String
  /// A key of CATEGORY_COLORS in @pa/shared.
  color      String
  /// One of CATEGORY_ICONS in @pa/shared.
  icon       String
  sortOrder  Int       @default(0)
  /// The category transfer fees are filed under. Exactly one row has this.
  isFees     Boolean   @default(false)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  entries   MoneyEntry[]
  shortcuts MoneyShortcut[]
  budget    MoneyBudget?
}

/// Someone the owner lends to or borrows from.
model MoneyPerson {
  id         String    @id @default(cuid())
  name       String
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  entries MoneyEntry[]
}

model MoneyEntry {
  id   String   @id @default(cuid())
  /// expense, income, transfer, correction or loan
  kind String
  /// The calendar day it belongs to, in the owner's time zone.
  date DateTime @db.Date
  /// Always positive.
  amount Int
  name   String
  note   String?

  accountId    String
  account      MoneyAccount @relation("EntryAccount", fields: [accountId], references: [id])
  /// Signed effect on `account`.
  accountDelta Int

  /// The receiving account of a transfer.
  toAccountId    String?
  toAccount      MoneyAccount? @relation("EntryToAccount", fields: [toAccountId], references: [id])
  toAccountDelta Int?

  categoryId String?
  category   MoneyCategory? @relation(fields: [categoryId], references: [id])

  personId      String?
  person        MoneyPerson? @relation(fields: [personId], references: [id])
  /// lent, borrowed, repaid_to_me or repaid_by_me
  loanDirection String?

  /// Set on a fee: the transfer it belongs to. Deleting the transfer deletes the fee.
  feeOfId String?     @unique
  feeOf   MoneyEntry? @relation("EntryFee", fields: [feeOfId], references: [id], onDelete: Cascade)
  fee     MoneyEntry? @relation("EntryFee")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([accountId])
  @@index([toAccountId])
  @@index([categoryId])
  @@index([personId])
}

/// A saved expense recorded with one tap, such as "Office rickshaw, 80, Cash".
model MoneyShortcut {
  id         String        @id @default(cuid())
  name       String
  amount     Int
  accountId  String
  account    MoneyAccount  @relation(fields: [accountId], references: [id])
  categoryId String
  category   MoneyCategory @relation(fields: [categoryId], references: [id])
  sortOrder  Int           @default(0)
  createdAt  DateTime      @default(now())
}

/// A monthly spending limit. The row with no category is the whole-month budget.
model MoneyBudget {
  id         String         @id @default(cuid())
  categoryId String?        @unique
  category   MoneyCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  amount     Int
  createdAt  DateTime       @default(now())
}

// ---------------------------------------------------------------------------
// Habits. Points are whole hundredths of a point.
// ---------------------------------------------------------------------------

/// One thing on the routine: breakfast by 8:30, Fajr, water every 90 minutes.
model HabitItem {
  id               String    @id @default(cuid())
  name             String
  points           Int
  /// A Timing from @pa/shared.
  timing           Json
  /// An AppliesTo from @pa/shared: days of the week, or day types.
  appliesTo        Json
  /// This item's own late share; null follows the setting.
  lateShare        Float?
  /// This item's own miss multiplier; null follows the setting.
  missMultiplier   Float?
  /// { channels, onOpen, onDue, warn }
  reminders        Json
  ignoreQuietHours Boolean   @default(false)
  sortOrder        Int       @default(0)
  /// Set while the item is off the routine but kept.
  pausedAt         DateTime?
  /// Set when removed. Past days keep their copy of it.
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())

  dayItems HabitDayItem[]
  marks    HabitMark[]
}

/// One habit day. Created the first time the day is reached.
model HabitDay {
  day           DateTime  @id @db.Date
  skipped       Boolean   @default(false)
  skippedReason String?
  /// The share of possible points that wins this day, as it stood on the day.
  targetPercent Int       @default(70)
  /// Set once the day has ended and its outcomes are stored.
  closedAt      DateTime?

  items HabitDayItem[]
}

/// A day's frozen copy of an item: the rules and window it is scored with.
model HabitDayItem {
  id             String    @id @default(cuid())
  day            DateTime  @db.Date
  habitDay       HabitDay  @relation(fields: [day], references: [day], onDelete: Cascade)
  itemId         String
  item           HabitItem @relation(fields: [itemId], references: [id])
  name           String
  points         Int
  lateShare      Float
  missMultiplier Float
  timing         Json
  opensAt        DateTime?
  dueAt          DateTime
  sortOrder      Int
  skipped        Boolean   @default(false)
  /// Stored when the day closes: onTime, late, missed or skipped.
  outcome        String?
  score          Int?

  @@unique([day, itemId])
  @@index([itemId])
}

/// One tap: the item was done at this instant, on this habit day.
model HabitMark {
  id        String    @id @default(cuid())
  day       DateTime  @db.Date
  itemId    String
  item      HabitItem @relation(fields: [itemId], references: [id])
  at        DateTime
  createdAt DateTime  @default(now())

  @@index([day, itemId])
}
